namespace AgentPolicy {
  entity Agent = {
    agent_type: String,
  };

  entity System;

  action "search" appliesTo {
    principal: [Agent],
    resource: [System],
    context: {}
  };

  action "fetch_content" appliesTo {
    principal: [Agent],
    resource: [System],
    context: { requested_domain?: String }
  };

  action "chrome_get_web_content" appliesTo {
    principal: [Agent],
    resource: [System],
    context: { requested_domain?: String }
  };

  action "doc_create" appliesTo {
    principal: [Agent],
    resource: [System],
    context: {}
  };

  action "doc_add_statement" appliesTo {
    principal: [Agent],
    resource: [System],
    context: { campaign_id?: String }
  };

  action "doc_set_verdict" appliesTo {
    principal: [Agent],
    resource: [System],
    context: { campaign_id?: String }
  };

  action "doc_write_content" appliesTo {
    principal: [Agent],
    resource: [System],
    context: { campaign_id?: String }
  };

  action "doc_get_verified" appliesTo {
    principal: [Agent],
    resource: [System],
    context: { campaign_id?: String }
  };

  action "doc_list" appliesTo {
    principal: [Agent],
    resource: [System],
    context: {}
  };

  action "doc_list_statements" appliesTo {
    principal: [Agent],
    resource: [System],
    context: { campaign_id?: String }
  };

  action "doc_status" appliesTo {
    principal: [Agent],
    resource: [System],
    context: {}
  };

  action "doc_get" appliesTo {
    principal: [Agent],
    resource: [System],
    context: { campaign_id?: String }
  };

  action "doc_assemble" appliesTo {
    principal: [Agent],
    resource: [System],
    context: {}
  };

  action "doc_publish_draft" appliesTo {
    principal: [Agent],
    resource: [System],
    context: {}
  };

  action "notify_human" appliesTo {
    principal: [Agent],
    resource: [System],
    context: { severity?: String }
  };

  action "doc_publish_live" appliesTo {
    principal: [Agent],
    resource: [System],
    context: { approval?: { status: String, action_kind: String } }
  };
}
